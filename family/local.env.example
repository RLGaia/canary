# Family server - machine settings
#
# Copy this file to family\local.env and fill it in:
#     Copy-Item family\local.env.example family\local.env
# local.env is git-ignored. Never commit it: it holds your database password.

# Database (MariaDB). setup.ps1 creates this database and user for you.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=canary
DB_USER=canary
DB_PASSWORD=CHANGE_ME

# Address the game client is sent to after login.
#   127.0.0.1   -> local test on the server PC only
#   100.x.y.z   -> this PC's Tailscale IP, for remote players (all PCs use it)
# The servers listen only on this address (see FAMILY.md, Security).
SERVER_IP=127.0.0.1
SERVER_NAME=Gaia Family

# Port of the login web service. 80 matches client 15.11 out of the box
# (conf\config.ini -> loginWebService=http://127.0.0.1/login.php).
# If port 80 is taken on your PC, use 8088 and change config.ini to
# http://127.0.0.1:8088/login.php
LOGIN_HTTP_PORT=80

# Optional: folder that contains mariadb.exe and mariadb-dump.exe.
# Leave empty to auto-detect "C:\Program Files\MariaDB *\bin".
MARIADB_BIN=

# Optional: where backup-db.ps1 stores dumps. Default: %USERPROFILE%\OT-backups
BACKUP_DIR=
