# Family server configuration (RLGaia/canary, branch "family")
#
# HOW TO USE
#   1. Copy this file to "docker/.env" (that file is git-ignored, so your
#      passwords never reach GitHub):
#         Copy-Item .env.family .env          (PowerShell, inside docker/)
#   2. Replace every CHANGE_ME value in docker/.env BEFORE the first start.
#      The database passwords are applied only when the database is created
#      for the first time. Changing them later breaks the connection.
#   3. Never put real passwords in this file. It is public on GitHub.
#
# Everything below is pinned to the stable release v3.6.1 so the server
# never updates itself by surprise. Change versions only on purpose,
# together with the matching game client (see FAMILY.md).

# ---------------------------------------------------------------------------
# Database (MariaDB) - set strong passwords before the first start
# ---------------------------------------------------------------------------
CANARY_DB_HOST=db
CANARY_DB_PORT=3306
CANARY_DB_NAME=canary
CANARY_DB_USER=canary
CANARY_DB_PASSWORD=CHANGE_ME_db_password
CANARY_DB_ROOT_PASSWORD=CHANGE_ME_db_root_password

# ---------------------------------------------------------------------------
# Server identity and address
# ---------------------------------------------------------------------------
# 127.0.0.1 = local test on the server PC only (Phase 2).
# For playing with Dad (Phase 4), replace with the server PC's Tailscale IP
# (100.x.y.z). Both PCs then use that same address.
CANARY_SERVER_NAME=Gaia Family
CANARY_SERVER_IP=127.0.0.1
CANARY_SERVER_LOCATION=BRA

# ---------------------------------------------------------------------------
# Canary game server - pinned to v3.6.1 (client 15.11)
# ---------------------------------------------------------------------------
CANARY_IMAGE=ghcr.io/opentibiabr/canary:3.6.1
CANARY_LOGIN_PORT=7171
CANARY_GAME_PORT=7172
CANARY_STATUS_PORT=7173
CANARY_STATUS_TIMEOUT=5000

# No public test accounts (@test1/test etc.). Create your own on the website.
CANARY_TEST_ACCOUNTS=false
CANARY_DATA_PACK=data-otservbr-global
CANARY_MAP_URL=https://github.com/opentibiabr/canary/releases/download/v3.6.1/otservbr.otbm

# ---------------------------------------------------------------------------
# MyAAC website (account creation / admin panel)
# ---------------------------------------------------------------------------
# Pinned to the slawkens/myaac "develop" commit from 2026-06-24, the version
# in use when Canary v3.6.1 was released and tested. A copy also exists in
# RLGaia/myaac.
MYAAC_REF=309bf4886a9e85a9ca17b4a6544adc51ccb5877c
MYAAC_HTTP_PORT=8080
MYAAC_SITE_URL=http://localhost:8080
# This admin is also an in-game GOD-level account. Its password is re-applied
# from this value every time the website container starts.
MYAAC_ADMIN_ACCOUNT=CHANGE_ME_admin_account
MYAAC_ADMIN_EMAIL=admin@localhost.local
MYAAC_ADMIN_PASSWORD=CHANGE_ME_admin_password
MYAAC_ADMIN_PLAYER=Gaia Admin
MYAAC_CLIENT_VERSION=1511
MYAAC_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Login server (client login webservice)
# ---------------------------------------------------------------------------
# v1.1.3 is the image behind Docker Hub "latest", the one Canary's own Docker
# smoke test validates. Pinned so it cannot change underneath us.
LOGIN_SERVER_IMAGE=opentibiabr/login-server:v1.1.3
LOGIN_HTTP_PORT=8088
LOGIN_GRPC_PORT=9090
LOGIN_RATE_LIMITER_RATE=2
LOGIN_RATE_LIMITER_BURST=5
